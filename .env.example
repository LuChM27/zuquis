# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Base de datos
POSTGRES_DB=zuquis
POSTGRES_USER=zuquis
POSTGRES_PASSWORD=cambiar-esta-clave
DATABASE_URL=postgresql+psycopg://zuquis:cambiar-esta-clave@db:5432/zuquis

# Seguridad (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# En producción con HTTPS: true. En desarrollo por http://localhost también funciona con true.
COOKIE_SECURE=true

# Aplicación
ZONA_HORARIA=America/Bogota
CORS_ORIGINS=http://localhost:5173
ARCHIVOS_DIR=/data/archivos
