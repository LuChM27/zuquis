# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# Base de datos
POSTGRES_DB=zuquis
POSTGRES_USER=zuquis
POSTGRES_PASSWORD=cambiar-esta-clave
DATABASE_URL=postgresql+psycopg://zuquis:cambiar-esta-clave@db:5432/zuquis

# Seguridad. OBLIGATORIO: la API no arranca sin una clave propia de 32+ caracteres
# (este valor de ejemplo se rechaza). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
# En producción con HTTPS: true. En desarrollo por http://localhost también funciona con true.
COOKIE_SECURE=true

# Aplicación
ZONA_HORARIA=America/Bogota
CORS_ORIGINS=http://localhost:5173
ARCHIVOS_DIR=/data/archivos

# Proxies de confianza para X-Forwarded-For (límite de intentos y auditoría con la IP real).
# Detrás de Caddy en producción: la IP del proxy. Nunca "*" si la API queda expuesta directamente.
FORWARDED_ALLOW_IPS=127.0.0.1
